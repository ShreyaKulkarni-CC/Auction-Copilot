{
  "manifest_version": 3,
  "name": "Auction Copilot (Prototype)",
  "version": "0.1.0",
  "description": "Reads a vAuto vehicle page (Condition Report / Glance / CARFAX) and shows a reconditioning-risk verdict before you bid.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.vauto.com/*", "*://*.vauto.app.coxautoinc.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.manheim.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Auction Copilot"
  }
}