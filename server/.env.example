# Copy this file to .env and fill in your own key.
# Get a Gemini API key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Double-check this is still a current model name before relying on it —
# verify at https://ai.google.dev/gemini-api/docs/models. Confirmed live
# 2026-09-15: "gemini-2.0-flash" has been retired by Google; use
# gemini-3.6-flash (or whatever the docs list as current) instead.
GEMINI_MODEL=gemini-3.6-flash

PORT=8787

# Only matters once this server is hosted somewhere public. Comma-separate
# multiple origins. Leave as * for local testing.
ALLOWED_ORIGINS=*

# Set to "production" once deployed (Render sets this for you by default,
# but double-check it's there under Environment). Turns on the HTTPS
# redirect in server.js. Leave unset for local dev.
NODE_ENV=development

# Optional. Leave blank for local testing. Once deployed publicly, set
# this to a random string and put the SAME string in
# EXTENSION_SHARED_SECRET near the top of extension/background.js, then
# rebuild/redistribute the extension. See the comment in server.js above
# requireExtensionKey() for exactly what this does and doesn't protect
# against.
EXTENSION_SHARED_SECRET=

# Buyer feedback ("Suggest a correction" on the verdict card) gets
# appended as a row to this Google Sheet via a service account. Leave all
# three blank to leave feedback disabled (POST /feedback just returns a
# clear "not configured yet" error instead of crashing). See the setup
# steps in this session's reply for exactly how to get these three
# values — short version: create a Google Cloud service account, enable
# the Sheets API, share your sheet with the service account's email as
# Editor, then fill these in from the account's downloaded JSON key.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the downloaded JSON key file exactly
# as-is, \n sequences and all, as one line — server.js converts those
# back to real newlines at startup. Treat this like a password: never
# commit it (.gitignore already excludes .env), and only ever set it as
# an environment variable, never in code.
GOOGLE_PRIVATE_KEY=